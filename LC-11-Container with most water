class Solution {
    func maxArea(_ height: [Int]) -> Int {
        if height.count <= 1 { return 0 }
        var i = 0
        var j = height.count - 1
        var a = 0
        while i <= j {
            if height[i] >= height[j] {
                a = max(a, height[j] * (j-i))
                j -= 1
            } else {
                a = max(a, height[i] * (j-i))
                i += 1
            }
        }
        return a
    }
}
let s = Solution()
print(s.maxArea([1]))
