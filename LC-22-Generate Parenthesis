class Solution {
    func generateParenthesis(_ n: Int) -> [String] {
        var r: [String] = []
        valid(r: &r, s: "", o: n, c: n)
        return r
    }
    // ( open,,,,, ) close
    func valid(r: inout[String], s: String, o: Int, c: Int) {  // open, close
        //print("s", s)
        if o > c { return } // invalid
        if o < 0 || c < 0 { return }
        if o == 0 && c == 0 { r.append(s) } // valid
        // either open (
        valid(r: &r, s: s+"(", o: o-1, c: c)
        // or close
        valid(r: &r, s: s+")", o: o, c: c-1)
    }
}
