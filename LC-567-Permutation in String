
Given two strings s1 and s2, return true if s2 contains a permutation of s1, or false otherwise.

In other words, return true if one of s1's permutations is the substring of s2.

 

Example 1:

Input: s1 = "ab", s2 = "eidbaooo"
Output: true
Explanation: s2 contains one permutation of s1 ("ba").



//////////////////

class Solution {
    func checkInclusion(_ s1: String, _ s2: String) -> Bool {
        var dict: [Character: Int] = [:]
        var c = 0
        for s in s1 {
            if dict[s] == nil {
                c += 1
                dict[s] = 1
            } else if let v = dict[s] {
                dict[s] = v + 1
            }
        }
        var i = 0
        var j = 0
        let m = s1.count
        while (c != 0) && (j < s2.count) {
            // if exceeding window
            if  j - i == m {
                let char = s2[s2.index(s2.startIndex, offsetBy: i)]
                if let v = dict[char] {
                    if v == 0 { c += 1 }
                    dict[char] = v + 1
                }
                // increment i
                i += 1
            }
            // in window
            let char = s2[s2.index(s2.startIndex, offsetBy: j)]
            if let v = dict[char] {
                // exists in dict
                dict[char] = v - 1
                if dict[char] == 0 {
                    c -= 1
                }
            }
            j += 1
        }
        return c == 0
    }
}
