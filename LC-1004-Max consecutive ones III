class Solution {
    func longestOnes(_ nums: [Int], _ k: Int) -> Int {
        if nums.isEmpty { return 0 }
        var cnt = 0
        var zeroCnt = k
        var zeroIdx = -1
        for (idx, num) in nums.enumerated() {
            if num == 1 {
                // increse cnt
                cnt = max(cnt, idx - zeroIdx)
            } else if num == 0 {
                // if zero can be flipped
                if zeroCnt > 0 {
                    zeroCnt -= 1
                    cnt = max(cnt, idx - zeroIdx)
                } else {
                    // can not be flipped, revert flip

                    // find next zero idx
                    var temp = zeroIdx + 1
                    while temp <= idx {
                        if nums[temp] == 0 {
                            zeroIdx = temp
                            break
                        }
                        temp += 1
                    }
                    // next zero index found
                    cnt = max(cnt, idx-zeroIdx)
                }
            }
        }
        return cnt
    }
}

let s = Solution()
print(s.longestOnes([0,0,1,1,0,0], 2))
